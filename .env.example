# Copie para .env e preencha com os seus valores: cp .env.example .env
# Nunca faça commit do arquivo .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=event_relay

# Cloudflare Queues (publicação das mensagens de retry)
# O token precisa da permissão "Queues Edit".
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_QUEUE_ID=your_cloudflare_queue_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Token exigido em todas as rotas da API (Authorization: Bearer <token>).
# Deve ser igual ao WORKER_AUTH_TOKEN configurado no retry-worker.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_AUTH_TOKEN=your_worker_auth_token

# Libera URLs locais e privadas, como http://localhost:4000/webhook (test-server).
# Use true somente em desenvolvimento. O valor é ignorado com NODE_ENV=production.
ALLOW_PRIVATE_URLS=false
